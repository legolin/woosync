      strong
        | mdo
    ul.dropdown-menu.dropdown-menu-dark.text-small.shadow[aria-labelledby="dropdownUser1"]
      li
        a.dropdown-item[href="#"]
          | New project...
      li
        a.dropdown-item[href="#"]
          | Settings
      li
        a.dropdown-item[href="#"]
          | Profile
      li
        hr.dropdown-divider
      li
        a.dropdown-item[href="#"]
          | Sign out
