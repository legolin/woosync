h2 Configuring Data Source
p Get started by uploading a sample of the file you will use for this data source.
= simple_form_for :feed, url: from_file_feed_mappings_path, method: :post, multipart: true, accept: "text/csv", data: { turbo: false } do |f|
  = f.input :file, as: :file
  = f.submit "Upload CSV"
